# Application & Database Configuration
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./jobs_platform.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/jobs_db

REDIS_URL=redis://localhost:6379/0

# OpenAI & LLM Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

# OpenAI Web Search Configuration (Responses API)
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_WEB_SEARCH_CONTEXT_SIZE=high
DEMO_MODE=false

# Observability (Langfuse / Tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OAuth Client Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email SMTP Settings (For Authorized Dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=candidate@example.com

# AWS Deployment (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Matching Thresholds
STRONG_MATCH_THRESHOLD=85.0
MATCH_THRESHOLD=75.0
POSSIBLE_MATCH_THRESHOLD=65.0
