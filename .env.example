# ==========================================
# AI Job Platform - Configuration (.env)
# Architecture: ChatGPT Web + MCP Server
# ==========================================

# 1. Database Configuration
# Default SQLite or MySQL/PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./jobs_platform.db
# DATABASE_URL=mysql+aiomysql://root:12345678@localhost:3306/AI_jobs_apply

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# 2. Operational Mode
DEMO_MODE=false
ENVIRONMENT=development

# 3. Model Context Protocol (MCP) Server Configuration
MCP_SERVER_NAME=job-platform-mcp
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_AUTH_MODE=development
ALLOWED_HOSTS=localhost,127.0.0.1,celery-ecosystem-suspense.ngrok-free.dev
MCP_PUBLIC_URL=https://celery-ecosystem-suspense.ngrok-free.dev
MCP_ALLOWED_ORIGINS=
MCP_SECRET_TOKEN=mcp-dev-token

# 4. Concurrency & Performance
MAX_CONCURRENT_APPLICATIONS=10
MAX_CONCURRENT_RECRUITER_RESEARCH=5

# 5. Deterministic 7-Factor Matching Thresholds
STRONG_MATCH_THRESHOLD=85
MATCH_THRESHOLD=75
POSSIBLE_MATCH_THRESHOLD=65

# 6. Email Outreach (SMTP Settings - Triggered ONLY upon explicit human approval)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# 7. Observability & Tracing (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 8. Optional Legacy / Future Integrations (NOT required for ChatGPT Web + MCP workflow)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_MODEL=gpt-4o
